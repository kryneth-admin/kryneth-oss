# ==============================================================================
# Kryneth Gateway - OSS Configuration Template
# Rename this file to .env before running `cargo run`
# ==============================================================================

# Server Config
GATEWAY_PORT=8080
RUST_LOG=info
JWT_SECRET=oss-dummy-secret-not-used-for-auth

# ── OSS Authentication ────────────────────────────────────────────────────────
# Comma-separated list of valid API keys for your local OSS gateway
KRYNETH_VALID_KEYS=re_live_local_dev_123

# ── Upstream LLM Keys ─────────────────────────────────────────────────────────
# These keys are automatically mapped by the api_key_alias in routing.yaml
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-your-anthropic-key-here

# (Optional) Add more keys as needed based on your routing.yaml
COHERE_API_KEY=
GROQ_API_KEY=