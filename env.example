# ==============================================================================
# Kryneth Gateway - OSS Configuration Template
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env:  cp env.example .env
# 2. Replace placeholder values with your actual API keys
# 3. Run setup script or docker-compose to start the gateway
# 
# IMPORTANT: Never commit the .env file with real credentials to git!
# Add to .gitignore:  echo ".env" >> .gitignore
# ==============================================================================

# ═══════════════════════════════════════════════════════════════════════════════
# 1. GATEWAY SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Port the gateway listens on
GATEWAY_PORT=8080

# Host to bind to (0.0.0.0 = accessible from any network interface)
GATEWAY_HOST=0.0.0.0

# Logging level: trace, debug, info, warn, error
RUST_LOG=info

# JWT Secret for authentication (change this in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ═══════════════════════════════════════════════════════════════════════════════
# 2. OSS AUTHENTICATION
# ═══════════════════════════════════════════════════════════════════════════════

# Comma-separated list of valid API keys for your local OSS gateway
# These keys are used with: Authorization: Bearer <key>
# Example: dev_key_123,prod_key_456,staging_key_789
KRYNETH_VALID_KEYS=dev_secret_123,local_dev_key

# ═══════════════════════════════════════════════════════════════════════════════
# 3. LLM PROVIDER API KEYS
# ═══════════════════════════════════════════════════════════════════════════════

# Groq API Key (Primary/Free provider for testing)
# Get key from: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cohere API Key (Failover/Secondary provider)
# Get key from: https://dashboard.cohere.com
COHERE_API_KEY=h28_your_cohere_key_here

# OpenAI API Key (Optional)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_your_openai_key_here

# Anthropic API Key (Optional)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# 4. RATE LIMITING (Optional - customize as needed)
# ═══════════════════════════════════════════════════════════════════════════════

# Maximum requests allowed per tenant per time window
# Example: 60 requests per 60 seconds = 1 request per second sustained
RATE_LIMIT_MAX_REQUESTS=60

# Time window in seconds for rate limit calculation
RATE_LIMIT_WINDOW_SECS=60

# ═══════════════════════════════════════════════════════════════════════════════
# 5. AGENT SAFETY GUARDS (Optional - customize for your use case)
# ═══════════════════════════════════════════════════════════════════════════════

# Maximum tool call executions within 60-second window
# Prevents "tool storms" - cascading tool calls that drain budgets
# Example: If agent calls tools 21 times in 60s, request is blocked
MAX_SESSION_TOOL_CALLS=20

# Maximum identical tool signatures within 60-second window
# Prevents infinite loops where agent repeats the exact same tool call
# Example: Agent calls get_weather(location="NYC") 6 times → BLOCKED
MAX_IDENTICAL_TOOL_CALLS=5

# ═══════════════════════════════════════════════════════════════════════════════
# 6. PERFORMANCE TUNING (Optional - advanced)
# ═══════════════════════════════════════════════════════════════════════════════

# Number of Tokio worker threads (defaults to CPU count)
# Set to CPU count for optimal performance on single machine
# TOKIO_WORKER_THREADS=8

# Maximum concurrent connections
# MAX_CONNECTIONS=1000

# Cache expiration time in seconds
# CACHE_TTL_SECS=60

# L1 cache size (number of entries)
# L1_CACHE_SIZE=10000

# ═══════════════════════════════════════════════════════════════════════════════
# QUICK START COMMANDS
# ═══════════════════════════════════════════════════════════════════════════════
# 
# After configuring this file:
# 
# Option 1: Docker Compose (Recommended)
#   docker-compose up -d --build
# 
# Option 2: Local Development
#   cargo run --release
# 
# Option 3: Docker Hub Image
#   docker run -p 8080:8080 --env-file .env -v $(pwd)/routing.yaml:/app/routing.yaml krynethgw/kryneth-gateway:latest
# 
# Test the gateway:
#   curl -X POST http://localhost:8080/v1/chat/completions \
#     -H "Content-Type: application/json" \
#     -d '{"model":"llama-3.3-70b-versatile","messages":[{"role":"user","content":"Hello!"}]}'
#
# ==============================================================================
